{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Giftbit API",
  "description": "Automatically order digital rewards and deliver them to your recipients with the Giftbit REST API.",
  "colors": {
    "primary": "#166E3F",
    "light": "#26BD6C",
    "dark": "#166E3F"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "mcp",
      "add-mcp"
    ]
  },
  "navigation": {
    "global": {
      "anchors": [
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "icon": "info",
            "expanded": true,
            "pages": [
              "index",
              "guides/environments",
              "guides/authentication",
              "guides/errors",
              "guides/getting-started",
              "guides/going-live"
            ]
          },
          {
            "group": "Reference",
            "icon": "code",
            "pages": [
              "guides/api-reference"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "api-reference/openapi.yaml",
        "groups": [
          {
            "group": "Ping",
            "icon": "signal",
            "pages": ["GET /ping"]
          },
          {
            "group": "Brands",
            "icon": "tags",
            "pages": ["GET /brands", "GET /brands/{brand_code}"]
          },
          {
            "group": "Regions",
            "icon": "earth-americas",
            "pages": ["GET /regions"]
          },
          {
            "group": "Email Orders",
            "icon": "envelope",
            "pages": ["POST /campaign", "GET /campaign/{id}"]
          },
          {
            "group": "Shortlink Orders",
            "icon": "link",
            "pages": ["POST /shortlink", "GET /links/{id}"]
          },
          {
            "group": "Direct Link Orders",
            "icon": "arrow-up-right-from-square",
            "pages": ["POST /direct_links"]
          },
          {
            "group": "Embedded Rewards",
            "icon": "mobile-screen",
            "pages": ["POST /embedded"]
          },
          {
            "group": "Funds",
            "icon": "wallet",
            "pages": ["GET /funds", "POST /funds"]
          },
          {
            "group": "Rewards",
            "icon": "gift",
            "pages": [
              "GET /gifts",
              "GET /gifts/{uuid}",
              "PUT /gifts/{uuid}",
              "DELETE /gifts/{uuid}"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/yourcompany",
      "linkedin": "https://linkedin.com/company/yourcompany"
    }
  }
}
